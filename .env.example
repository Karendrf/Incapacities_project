# Server Configuration
NODE_ENV=development
PORT=3002
HOST=0.0.0.0

# Database Configuration
DB_HOST=postgres_payroll
DB_PORT=5432
DB_NAME=payroll_db
DB_USER=payroll_user
DB_PASSWORD=payroll_password
DB_DIALECT=postgres
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRATION=24h

# Service Configuration
SERVICE_NAME=payroll-service
LOG_LEVEL=info

# Sequelize
DB_LOGGING=false

# Other Microservices URLs
USER_SERVICE_URL=http://user-service:3001
INCAPACITY_SERVICE_URL=http://incapacity-service:3003